# Build artifacts (runtime/dist/ is committed -- it's the published bundle)
*.tsbuildinfo

# Local config
.env
.env.local
.yujin-forge/
.tmp/

# Private keys. The contract signing key lives OUTSIDE this repository by
# design (owner decision 2026-10-24, PND-034 option A) and
# scripts/sign-contract-api.mjs refuses any path under the repo root. These
# lines are the second belt, for a key that arrives here some other way.
*.pem
*.key
.nac3-keys/

# Translation work orders: generated from SPEC.md by
# scripts/build-spec-translations.mjs --parts, merged back with --merge.
# The authored artifact is i18n/<locale>/SPEC.units.md, which IS tracked.
.translation-parts/
.tmp-probe/
