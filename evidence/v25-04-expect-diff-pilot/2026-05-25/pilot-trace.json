      "id": "wait-for-effect",
      "text": "In the \"canvas\" plugin the state \"canvas.value\" can be set via the host-side window.canvasApp.set(n) function. Schedule a deferred set (canvasApp.set(9) after 400ms) and then use NAC.expect to wait until canvas.value reaches 9, with a timeout of 2000ms. Report the resolved value.",
      "expect": {
        "final_value": 9
      },
      "plan_raw": "{\"steps\":[{\"op\":\"set_after\",\"value\":9,\"delay_ms\":400},{\"op\":\"expect\",\"state_path\":\"canvas.value\",\"value\":9,\"timeout_ms\":2000},{\"op\":\"read\",\"state_path\":\"canvas.value\"}]}",
      "plan": {
        "steps": [
          {
            "op": "set_after",
            "value": 9,
            "delay_ms": 400
          },
          {
            "op": "expect",
            "state_path": "canvas.value",
            "value": 9,
            "timeout_ms": 2000
          },
          {
            "op": "read",
            "state_path": "canvas.value"
          }
        ]
      },
      "results": [
        {
          "idx": 0,
          "op": "set_after",
          "value": 9,
          "delay_ms": 400,
          "ok": true
        },
        {
          "idx": 1,
          "op": "expect",
          "state_path": "canvas.value",
          "want": 9,
          "resolved": 9,
          "ok": true,
          "duration_ms": 442
        },
        {
          "idx": 2,
          "op": "read",
          "state_path": "canvas.value",
          "value": 9,
          "ok": true
        }
      ],
      "screenshot": "evidence\\v25-04-expect-diff-pilot\\2026-05-25\\wait-for-effect.png"
    },
