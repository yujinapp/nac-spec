{
  "name": "nac-spec-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Project-root tooling (Playwright demos + scripts). The publishable runtime lives under runtime/ with its own package.json.",
  "type": "module",
  "scripts": {
    "demo:v25-canvas-api": "node scripts/run-demo-v25-canvas-api.mjs",
    "serve": "python -m http.server 8855",
    "check:integrity": "node scripts/build-integrity.mjs",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:contract": "node scripts/build-contract-api.mjs",
    "build:contract": "node scripts/build-contract-api.mjs --write",
    "verify:contract": "node scripts/verify-contract-api.mjs --expect-head-from-repo",
    "check:npm": "node scripts/verify-npm-publication.mjs --mode release --witness-release",
    "verify:npm": "node scripts/verify-npm-publication.mjs --mode post-publish",
    "test:npm-gate": "node scripts/test-npm-publication-gate.mjs",
    "keygen:contract": "node scripts/sign-contract-api.mjs --keygen",
    "sign:contract": "node scripts/sign-contract-api.mjs --sign",
    "check:release": "node scripts/build-integrity.mjs && node scripts/check-stylesheet-links.mjs && node scripts/check-mount-path.mjs && node scripts/test-mount-path.mjs && node scripts/check-version-coherence.mjs && node scripts/build-contract-api.mjs && node scripts/test-version-gate.mjs && node scripts/build-spec-translations.mjs && node scripts/build-translation-banners.mjs && node scripts/test-spec-translations.mjs && node scripts/test-landing-i18n.mjs && node scripts/smoke-live-landing.mjs --selftest && node scripts/verify-npm-publication.mjs --mode release --witness-release && node scripts/test-npm-publication-gate.mjs",
    "test:integrity": "node scripts/test-integrity-load.mjs",
    "check:stylesheets": "node scripts/check-stylesheet-links.mjs",
    "test:stylesheets": "node scripts/test-stylesheet-links.mjs",
    "check:mount": "node scripts/check-mount-path.mjs",
    "test:mount-gate": "node scripts/test-mount-path.mjs",
    "test:integrity-gate": "node scripts/test-integrity-gate.mjs",
    "test:version-gate": "node scripts/test-version-gate.mjs",
    "test:contract": "node scripts/test-contract-api.mjs",
    "test:contract-http": "node scripts/test-contract-api-http.mjs",
    "test:limits": "node e2e/landing-limits-check.mjs",
    "test:fill-setter": "node e2e/fill-native-setter-check.mjs",
    "test:snippet": "node e2e/snippet-install-check.mjs",
    "test:validate-global": "node scripts/test-validate-global.mjs",
    "test:cli-levels": "node scripts/test-cli-levels.mjs",
    "check:translations": "node scripts/build-spec-translations.mjs && node scripts/build-translation-banners.mjs",
    "build:translations": "node scripts/build-spec-translations.mjs --write && node scripts/build-translation-banners.mjs --write",
    "test:translations-gate": "node scripts/test-translations-gate.mjs",
    "test:translations": "node e2e/translations-check.mjs",
    "test:landing-i18n": "node scripts/test-landing-i18n.mjs",
    "test:smoke-live": "node scripts/smoke-live-landing.mjs --selftest",
    "smoke:live": "node scripts/smoke-live-landing.mjs --base https://yujin.app/nac-spec/ --retries 3",
    "test:spec-translations": "node scripts/test-spec-translations.mjs",
    "stats:translations": "node scripts/build-spec-translations.mjs --stats"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
