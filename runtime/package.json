{
  "name": "@nac3/runtime",
  "version": "2.5.1",
  "description": "Native Agent Contract -- spec + reference runtime that lets web UIs be driven by AI agents, voice runners, and accessibility tools.",
  "keywords": [
    "nac",
    "native-agent-contract",
    "agent",
    "voice",
    "llm",
    "automation",
    "accessibility",
    "ai",
    "ui-contract",
    "yujin"
  ],
  "homepage": "https://yujin.app/nac-spec/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yujinapp/nac-spec.git",
    "directory": "runtime"
  },
  "bugs": "https://github.com/yujinapp/nac-spec/issues",
  "author": "Yujin (https://yujin.app)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/nac.cjs",
  "module": "./dist/nac.mjs",
  "types": "./dist/nac.d.ts",
  "browser": "./dist/nac.browser.js",
  "exports": {
    ".": {
      "types": "./dist/nac.d.ts",
      "import": "./dist/nac.mjs",
      "require": "./dist/nac.cjs",
      "browser": "./dist/nac.browser.js",
      "default": "./dist/nac.mjs"
    },
    "./extensions": {
      "types": "./dist/nac-v2-extensions.d.ts",
      "import": "./dist/nac-v2-extensions.mjs",
      "require": "./dist/nac-v2-extensions.cjs",
      "browser": "./dist/nac-v2-extensions.browser.js",
      "default": "./dist/nac-v2-extensions.mjs"
    },
    "./chat-client": {
      "types": "./dist/nac-chat-client.d.ts",
      "import": "./dist/nac-chat-client.mjs",
      "require": "./dist/nac-chat-client.cjs",
      "browser": "./dist/nac-chat-client.browser.js",
      "default": "./dist/nac-chat-client.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nac3": "./dist/cli.js",
    "nac": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "SPEC.md",
    "CHANGELOG.md",
    "contract-head.json"
  ],
  "scripts": {
    "build": "node ./build.mjs",
    "test": "node ./test/smoke.mjs && node ./test/v22.mjs && node ./test/v23-invoke.mjs && node ./test/v23-shadow.mjs && node ./test/v23-capabilities.mjs && node ./test/v23-editor.mjs && node ./test/v23-interop.mjs && node ./test/stage2-disambiguation.mjs && node ./test/stage7-strict-resolution.mjs && node ./test/stage8-plugin-extension.mjs && node ./test/stage9-sync-plugin.mjs && node ./test/stage10-authority-sudo.mjs && node ./test/stage11-plugin-id-dedup.mjs && node ./test/stage12-snapshot-versioning.mjs",
    "test:smoke": "node ./test/smoke.mjs",
    "test:v22": "node ./test/v22.mjs",
    "test:v23": "node ./test/v23-invoke.mjs",
    "test:v23-shadow": "node ./test/v23-shadow.mjs",
    "test:v23-caps": "node ./test/v23-capabilities.mjs",
    "test:v23-editor": "node ./test/v23-editor.mjs",
    "test:v23-interop": "node ./test/v23-interop.mjs",
    "test:stage2": "node ./test/stage2-disambiguation.mjs",
    "test:stage7": "node ./test/stage7-strict-resolution.mjs",
    "test:stage8": "node ./test/stage8-plugin-extension.mjs",
    "test:stage9": "node ./test/stage9-sync-plugin.mjs",
    "test:stage10": "node ./test/stage10-authority-sudo.mjs",
    "test:stage11": "node ./test/stage11-plugin-id-dedup.mjs",
    "prepublishOnly": "npm run build && node ../scripts/check-version-coherence.mjs && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
